{
  "scripts": {
    "build": "node compiler/index.js . dist",
    "dev": "node compiler/index.js . dist && npx serve dist"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-sonar-reporter": "^2.0.0",
    "jest-stare": "^2.5.1",
    "jsdoc": "^4.0.3",
    "lint-staged": "^15.2.2",
    "rimraf": "^5.0.7",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "functions": 100,
        "statements": 80,
        "branches": 80
      }
    },
    "coverageReporters": [
      "cobertura",
      "html"
    ],
    "collectCoverageFrom": [
      "**/main/utils/separateBoldFragments.{js,jsx}"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "reporters": [
      "default",
      "jest-junit"
    ],
    "testResultsProcessor": "jest-sonar-reporter",
    "testTimeout": 30000
  },
  "jest-junit": {
    "outputDirectory": "coverage",
    "outputName": "junit.xml",
    "usePathForSuiteName": "true"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-sonar-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "fs-extra": "^11.3.5"
  }
}
